+// Copyright (c) 2026 ProtonX contributors. SPDX-License-Identifier: AGPL-3.0-only
+// SDK-owned cache only; never decrypt to a temporary/export file.
+use std::{io, path::Path};
+pub async fn read(path: impl AsRef<Path>) -> io::Result<Vec<u8>> {
+    #[cfg(feature = "protonx-encrypted")]
+    if protonx_mail_storage::cache_encryption_enabled() {
+        let path = path.as_ref().to_owned();
+        return tokio::task::spawn_blocking(move || protonx_mail_storage::read_cached_file(&path)).await.map_err(|_| io::Error::from(io::ErrorKind::Other))?;
+    }
+    tokio::fs::read(path).await
+}
+pub async fn write(path: &Path, data: Vec<u8>) -> io::Result<()> {
+    #[cfg(feature = "protonx-encrypted")]
+    if protonx_mail_storage::cache_encryption_enabled() {
+        let path = path.to_owned();
+        return tokio::task::spawn_blocking(move || protonx_mail_storage::write_cached_file(&path, &data)).await.map_err(|_| io::Error::from(io::ErrorKind::Other))?;
+    }
+    mail_core_common::os::safe_write_async(path, data).await
+}
+pub fn filename(original: &str) -> String {
+    #[cfg(feature = "protonx-encrypted")]
+    if protonx_mail_storage::cache_encryption_enabled() { return "content.pxb".into(); }
+    mail_core_common::os::sanitize_filename(original)
+}
