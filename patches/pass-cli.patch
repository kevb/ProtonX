+    #[test]
+    fn paid_lease_honours_plan_trial_subscription_and_unknown_managed_policy() {
+        assert_eq!(expiry(&plan(PlanType::Plus), NOW), Some(NOW + CACHE_TTL));
+        for kind in [PlanType::Free, PlanType::Business] {
+            assert_eq!(expiry(&plan(kind), NOW), None);
+        }
+        let mut p = plan(PlanType::Plus);
+        p.trial_end = Some((NOW + 600) as u64);
+        p.subscription_end = Some((NOW + 300) as u64);
+        assert_eq!(expiry(&p, NOW), Some(NOW + 300));
+        p.trial_end = Some(NOW as u64);
+        assert_eq!(expiry(&p, NOW), None);
+        assert_eq!(expiry(&plan(PlanType::Plus), i64::MAX), None);
+    }
