+// A desktop protocol identity does not expose the CLI product's automation,
+// agents, export, PAT, permanent deletion or process-injection surface.
+impl Commands {
+    fn is_native_desktop_supported(&self) -> bool {
+        use commands::item::{ItemCommands, create::CreateCommands};
+        match self {
+            Self::Login {
+                username: None,
+                pat: None,
+                ..
+            }
+            | Self::Logout { .. } => true,
+            Self::Vault {
+                command: commands::vault::VaultCommands::List { .. },
+            } => true,
+            Self::Item { command } => match command {
+                ItemCommands::List {
+                    show_secrets: false,
+                    ..
+                }
+                | ItemCommands::View {
+                    uri: None,
+                    field: None,
+                    ..
+                }
+                | ItemCommands::Trash { .. }
+                | ItemCommands::Untrash { .. } => true,
+                ItemCommands::Create {
+                    create_command: CreateCommands::Login { .. } | CreateCommands::Note { .. },
+                } => true,
+                ItemCommands::Update { fields, .. } => fields == &["@stdin"],
+                _ => false,
+            },
+            #[cfg(feature = "protonx-desktop")]
+            Self::NativeCapabilities
+            | Self::NativeSnapshot
+            | Self::NativeCacheSnapshot
+            | Self::NativeCacheDetail { .. }
+            | Self::NativeCreate { .. }
+            | Self::NativeEdit { .. }
+            | Self::NativeTotp { .. } => true,
+            _ => false,
+        }
+    }
+}
