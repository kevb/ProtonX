+                .is_err()
+        );
+        assert_eq!(std::fs::read(path).unwrap(), original[..40]);
+    }
+}
diff --git a/pass-cli/src/native_ui.rs b/pass-cli/src/native_ui.rs
new file mode 100644
index 0000000..7721344
--- /dev/null
+++ b/pass-cli/src/native_ui.rs
@@ -0,0 +1,545 @@
+// Copyright (c) 2026 ProtonX contributors. GPL-3.0-or-later.
+// Native presentation/transport only: all cryptography and writes use Proton's SDK.
+use crate::helpers::{CliPassClient, PassClientExt};
+use anyhow::{Result, anyhow, ensure};
+use pass::PlanType;
+use pass::domain::{
+    Item, ItemContent, ItemData, ItemExtraField, ItemExtraFieldContent, ItemId, ItemState,
+    LoginItem, NoteItem, PermissionFlag, ShareId,
+};
+use serde::{Deserialize, Serialize};
+use std::{collections::HashSet, io::Read};
+
+#[derive(Serialize)]
+struct NativeVault {
+    name: String,
+    vault_id: String,
+    share_id: String,
+    can_create: bool,
+    can_update: bool,
+    can_trash: bool,
+}
+
+/// Only a transport interruption may retain a previously valid saved generation.
+fn may_retain_cache(error: &anyhow::Error) -> bool {
+    error.chain().find_map(|source| source.downcast_ref::<muon::Error>()).is_some_and(|error|
+        matches!(error.kind(), muon::ErrorKind::Resolve | muon::ErrorKind::Dial |
+            muon::ErrorKind::Connect | muon::ErrorKind::Send))
+}
+
+pub async fn snapshot(client: CliPassClient, binding: (String, String)) -> Result<()> {
+    let features = client.get_cli_client_features()?;
+    let result = snapshot_inner(client, binding).await;
+    if let Err(error) = &result {
+        if !may_retain_cache(error) {
+            // Failure to invalidate is itself a failure; never silently reset keys.
+            crate::native_cache::clear(&features.database_manager).await?;
+        }
+    }
+    result
+}
+
+async fn snapshot_inner(client: CliPassClient, binding: (String, String)) -> Result<()> {
+    ensure!(
+        !crate::protonx::policy().requires_cli_eligibility,
+        "Native transport required"
+    );
+    let plan = client.get_user_access().await?.plan;
+    let features = client.get_cli_client_features()?;
+    let now = jiff::Timestamp::now().as_second();
+    let cache_expiry = crate::native_cache::expiry(&plan, now);
+    if cache_expiry.is_none() { crate::native_cache::clear(&features.database_manager).await?; }
+    let mut saved_records = vec![];
+    let mut vaults = vec![];
+    let mut active = vec![];
+    let mut trashed = vec![];
+    for vault in client.list_vaults().await? {
+        let share = client.get_share(&vault.share_id).await?;
+        let admin = share.has_permission(PermissionFlag::Admin);
+        let entries = if cache_expiry.is_some() {
+            client.native_snapshot_items(&vault.share_id).await?.into_iter().map(|(item, record)| {
+                saved_records.push(record); item
+            }).collect()
+        } else { client.list_items(&vault.share_id).await? };
+        for item in entries {
+            let summary = crate::commands::item::list::ItemSummary::from(&item);
+            match item.state {
+                ItemState::Active => active.push(summary),
+                ItemState::Trashed => trashed.push(summary),
+            }
+        }
+        vaults.push(NativeVault {
+            name: vault.content.name,
+            vault_id: vault.id.to_string(),
+            share_id: vault.share_id.to_string(),
+            can_create: admin || share.has_permission(PermissionFlag::Create),
+            can_update: admin || share.has_permission(PermissionFlag::Update),
+            can_trash: admin
+                || (share.has_permission(PermissionFlag::Trash)
+                    && share.has_permission(PermissionFlag::Delete)),
+        });
+    }
+    let mut result = serde_json::json!({"vaults":vaults,"items":active,"trashed_items":trashed,
+        "capabilities":{"totp_limit":plan.totp_limit,"custom_fields_allowed":plan.plan_type != PlanType::Free}});
+    let mut cache_status = "planUnavailable";
+    if let Some(expires_at) = cache_expiry {
+        let (user_id, session_id) = binding;
+        let header = crate::native_cache::Header { schema: 1, user_id, session_id, plan: plan.plan_type,
+            saved_at: now, expires_at, generation: uuid::Uuid::new_v4().to_string(), snapshot: result.clone() };
+        cache_status = if crate::native_cache::replace(&features.database_manager, header, saved_records).await.is_ok() {
+            "ready"
+        } else { "unavailable" };
+    }
+    result["cache_status"] = serde_json::json!(cache_status);
+    println!("{}", result);
+    Ok(())
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct FieldEdit {
+    source_index: Option<usize>,
+    expected_name: Option<String>,
+    expected_hidden: Option<bool>,
+    name: String,
+    value: String,
+    concealed: bool,
+    #[serde(default)]
+    remove: bool,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Draft {
+    kind: String,
+    title: String,
+    note: String,
+    username: Option<String>,
+    email: Option<String>,
+    password: Option<String>,
+    urls: Option<Vec<String>>,
+    totp_uri: Option<String>,
+    #[serde(default)]
+    custom_fields: Vec<FieldEdit>,
+    expected_revision: Option<u64>,
+}
+
+fn read_draft() -> Result<Draft> {
+    let mut input = zeroize::Zeroizing::new(String::new());
+    std::io::stdin().take(262145).read_to_string(&mut input)?;
+    ensure!(
+        input.len() <= 262144,
+        "Native item input exceeds size limit"
+    );
+    let draft: Draft = serde_json::from_str(&input)?;
+    ensure!(!draft.title.trim().is_empty(), "Item title is required");
+    ensure!(
+        matches!(draft.kind.as_str(), "login" | "note"),
+        "Unsupported native item kind"
+    );
+    if let Some(uri) = &draft.totp_uri {
+        ensure!(draft.kind == "login", "Only logins can have TOTP");
+        if !uri.is_empty() {
+            ensure!(
+                uri.starts_with("otpauth://totp/"),
+                "A TOTP setup URI is required"
+            );
+            proton_pass_common::totp::TOTP::from_uri(uri)
+                .map_err(|_| anyhow!("Invalid TOTP setup URI"))?;
+        }
+    }
+    Ok(draft)
+}
+
+fn apply_draft(content: &mut ItemData, draft: &Draft) -> Result<()> {
+    ensure!(
+        matches!(
+            (&content.content, draft.kind.as_str()),
+            (ItemContent::Login(_), "login") | (ItemContent::Note(_), "note")
+        ),
+        "Item kind changed"
+    );
+    content.title = draft.title.clone();
+    content.note = draft.note.clone();
+    if let ItemContent::Login(login) = &mut content.content {
+        if let Some(value) = &draft.username {
+            login.username = value.clone();
+        }
+        if let Some(value) = &draft.email {
+            login.email = value.clone();
+        }
+        if let Some(value) = &draft.password {
+            login.password = value.clone();
+        }
+        if let Some(value) = &draft.totp_uri {
+            login.totp_uri = value.clone();
+        }
+        if let Some(urls) = &draft.urls {
+            // Keep matching modes for unchanged modern entries. New addresses use
+            // the legacy/default URL list; passkeys and other content stay intact.
+            login
+                .autofill_urls
+                .retain(|entry| urls.contains(&entry.url));
+            login.urls = urls
+                .iter()
+                .filter(|url| !login.autofill_urls.iter().any(|entry| &entry.url == *url))
+                .cloned()
+                .collect();
+        }
+    }
+    let original_field_count = content.extra_fields.len();
+    let mut seen = HashSet::new();
+    let mut removed = vec![];
+    for field in &draft.custom_fields {
+        ensure!(
+            !field.name.trim().is_empty(),
+            "Custom field name is required"
+        );
+        let value = if field.concealed {
+            ItemExtraFieldContent::Hidden(field.value.clone())
+        } else {
+            ItemExtraFieldContent::Text(field.value.clone())
+        };
+        if let Some(index) = field.source_index {
+            ensure!(
+                index < original_field_count,
+                "Custom field changed; refresh before editing"
+            );
+            ensure!(seen.insert(index), "Duplicate custom field edit");
+            let original = content
+                .extra_fields
+                .get_mut(index)
+                .ok_or_else(|| anyhow!("Custom field changed; refresh before editing"))?;
+            let hidden = match original.content {
+                ItemExtraFieldContent::Hidden(_) => true,
+                ItemExtraFieldContent::Text(_) => false,
+                _ => return Err(anyhow!("This custom field type is read-only")),
+            };
+            ensure!(
+                field.expected_name.as_deref() == Some(original.name.as_str())
+                    && field.expected_hidden == Some(hidden),
+                "Custom field changed; refresh before editing"
+            );
+            if field.remove {
+                removed.push(index);
+            } else {
+                original.name = field.name.clone();
+                original.content = value;
+            }
+        } else {
+            ensure!(!field.remove, "Cannot remove an unsaved field");
+            content.extra_fields.push(ItemExtraField {
+                name: field.name.clone(),
+                content: value,
+            });
+        }
+    }
+    removed.sort_unstable();
+    for index in removed.into_iter().rev() {
+        content.extra_fields.remove(index);
+    }
+    Ok(())
+}
+
+fn totp_allowed(limit: Option<u16>, active: &[Item], existing: Option<&Item>) -> bool {
+    let Some(limit) = limit else {
+        return true;
+    };
+    let mut configured: Vec<&Item> = active.iter().filter(|item| item.state == ItemState::Active &&
+        matches!(&item.content.content, ItemContent::Login(login) if !login.totp_uri.is_empty())).collect();
+    configured.sort_by_key(|item| item.create_time);
+    if let Some(item) = existing {
+        if matches!(&item.content.content, ItemContent::Login(login) if !login.totp_uri.is_empty())
+        {
+            return configured
+                .iter()
+                .take(limit as usize)
+                .any(|candidate| candidate.id == item.id && candidate.share_id == item.share_id);
+        }
+    }
+    configured.len() < limit as usize
+}
+
+async fn guard_features(
+    client: &CliPassClient,
+    draft: &Draft,
+    existing: Option<&Item>,
+) -> Result<()> {
+    let plan = client.get_user_access().await?.plan;
+    ensure!(
+        draft.custom_fields.is_empty() || plan.plan_type != PlanType::Free,
+        "Custom fields are unavailable for this plan"
+    );
+    if draft.totp_uri.as_ref().is_some_and(|uri| !uri.is_empty()) && plan.totp_limit.is_some() {
+        let mut active = vec![];
+        for vault in client.list_vaults().await? {
+            active.extend(client.list_items(&vault.share_id).await?);
+        }
+        ensure!(
+            totp_allowed(plan.totp_limit, &active, existing),
+            "TOTP setup limit reached"
+        );
+    }
+    Ok(())
+}
+
+pub async fn create(client: CliPassClient, share_id: String) -> Result<()> {
+    ensure!(
+        !crate::protonx::policy().requires_cli_eligibility,
+        "Native transport required"
+    );
+    let draft = read_draft()?;
+    guard_features(&client, &draft, None).await?;
+    let content = if draft.kind == "note" {
+        ItemContent::Note(NoteItem)
+    } else {
+        ItemContent::Login(LoginItem {
+            email: String::new(),
+            username: String::new(),
+            password: String::new(),
+            urls: vec![],
+            totp_uri: String::new(),
+            passkeys: vec![],
+            autofill_urls: vec![],
+        })
+    };
+    let mut item = ItemData::new(
+        draft.title.clone(),
+        String::new(),
+        ItemData::generate_uuid(),
+        content,
+        vec![],
+    )?;
+    ensure!(
+        draft
+            .custom_fields
+            .iter()
+            .all(|field| field.source_index.is_none()),
+        "New items cannot refer to existing fields"
+    );
+    apply_draft(&mut item, &draft)?;
+    let id = client
+        .create_native_item(&ShareId::new(share_id), item)
+        .await?;
+    println!("{}", serde_json::json!({"item_id": id}));
+    Ok(())
+}
+
+pub async fn edit(client: CliPassClient, share_id: String, item_id: String) -> Result<()> {
+    ensure!(
+        !crate::protonx::policy().requires_cli_eligibility,
+        "Native transport required"
+    );
+    let draft = read_draft()?;
+    let share_id = ShareId::new(share_id);
+    let item_id = ItemId::new(item_id);
+    let details = client.view_item(&share_id, &item_id).await?;
+    let expected = draft
+        .expected_revision
+        .ok_or_else(|| anyhow!("Item revision is required"))?;
+    if expected != details.revision {
+        return Err(pass::NativeRevisionConflict.into());
+    }
+    ensure!(
+        details.item.state == ItemState::Active,
+        "Restore the item before editing"
+    );
+    guard_features(&client, &draft, Some(&details.item)).await?;
+    let mut content = details.item.content;
+    apply_draft(&mut content, &draft)?;
+    client
+        .update_native_item(&share_id, &item_id, content, expected)
+        .await?;
+    println!("{}", serde_json::json!({"updated": true}));
+    Ok(())
+}
+
+pub async fn totp(client: CliPassClient, share_id: String, item_id: String) -> Result<()> {
+    ensure!(
+        !crate::protonx::policy().requires_cli_eligibility,
+        "Native transport required"
+    );
+    let details = client
+        .view_item(&ShareId::new(share_id), &ItemId::new(item_id))
+        .await?;
+    ensure!(
+        details.item.state == ItemState::Active,
+        "Restore the item before using TOTP"
+    );
+    let login = match &details.item.content.content {
+        ItemContent::Login(login) if !login.totp_uri.is_empty() => login,
+        _ => return Err(anyhow!("This item has no login TOTP setup")),
+    };
+    let plan = client.get_user_access().await?.plan;
+    if plan.totp_limit.is_some() {
+        let mut items = vec![];
+        for vault in client.list_vaults().await? {
+            items.extend(client.list_items(&vault.share_id).await?);
+        }
+        ensure!(
+            totp_allowed(plan.totp_limit, &items, Some(&details.item)),
+            "TOTP access limit reached"
+        );
+    }
+    println!(
+        "{}",
+        crate::commands::item::totp::generate_totp_token(&login.totp_uri)?
+    );
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn only_connection_errors_retain_saved_cache_even_with_context() {
+        for error in [muon::ErrorKind::resolve("synthetic"), muon::ErrorKind::dial("synthetic"),
+            muon::ErrorKind::connect("synthetic"), muon::ErrorKind::send("synthetic")] {
+            assert!(may_retain_cache(&anyhow::Error::from(error).context("wrapper")));
+        }
+        for error in [muon::ErrorKind::tls("synthetic"), muon::ErrorKind::auth("synthetic"),
+            muon::Error::other("synthetic")] { assert!(!may_retain_cache(&error.into())); }
+        assert!(!may_retain_cache(&anyhow!("Unknown schema or plan")));
+    }
+
+    fn content() -> ItemData {
+        let mut item = ItemData::new(
+            "Synthetic".into(),
+            "note".into(),
+            "synthetic".into(),
+            ItemContent::Login(LoginItem {
+                email: "alex@example.com".into(),
+                username: "alex".into(),
+                password: "SYNTHETIC".into(),
+                urls: vec!["https://example.com".into()],
+                totp_uri: "otpauth://totp/Synthetic?secret=JBSWY3DPEHPK3PXP".into(),
+                passkeys: vec![],
+                autofill_urls: vec![],
+            }),
+            vec![],
+        )
+        .unwrap();
+        item.extra_fields = vec![
+            ItemExtraField {
+                name: "Timestamp".into(),
+                content: ItemExtraFieldContent::Timestamp(123),
+            },
+            ItemExtraField {
+                name: "Recovery".into(),
+                content: ItemExtraFieldContent::Hidden("OLD-SYNTHETIC".into()),
+            },
+        ];
+        item
+    }
+    #[test]
+    fn native_edit_preserves_unedited_content_and_custom_types() {
+        let mut item = content();
+        let draft: Draft = serde_json::from_str(r#"{"kind":"login","title":"Renamed","note":"new","custom_fields":[{"source_index":1,"expected_name":"Recovery","expected_hidden":true,"name":"Recovery","value":"NEW-SYNTHETIC","concealed":true}]}"#).unwrap();
+        apply_draft(&mut item, &draft).unwrap();
+        assert_eq!(item.title, "Renamed");
+        assert_eq!(
+            item.extra_fields[0].content,
+            ItemExtraFieldContent::Timestamp(123)
+        );
+        assert_eq!(
+            item.extra_fields[1].content,
+            ItemExtraFieldContent::Hidden("NEW-SYNTHETIC".into())
+        );
+        if let ItemContent::Login(login) = item.content {
+            assert_eq!(login.password, "SYNTHETIC");
+            assert_eq!(login.urls, ["https://example.com"]);
+            assert!(!login.totp_uri.is_empty());
+        } else {
+            panic!();
+        }
+    }
+    #[test]
+    fn native_edit_rejects_stale_or_readonly_custom_fields() {
+        for index in [0, 1, 5] {
+            let draft: Draft = serde_json::from_value(serde_json::json!({"kind":"login","title":"Test","note":"","custom_fields":[{"source_index":index,"expected_name":"Wrong","expected_hidden":true,"name":"New","value":"Synthetic","concealed":false}]})).unwrap();
+            assert!(apply_draft(&mut content(), &draft).is_err());
+        }
+    }
+    #[test]
+    fn native_edit_preserves_modern_url_matching_modes() {
+        let mut item = content();
+        if let ItemContent::Login(login) = &mut item.content {
+            login.autofill_urls.push(pass::domain::AutofillUrl {
+                url: "https://example.org".into(),
+                mode: pass::domain::AutofillUrlMode::Never,
+            });
+        }
+        let draft:Draft=serde_json::from_str(r#"{"kind":"login","title":"Test","note":"","urls":["https://example.org","https://new.example.com"]}"#).unwrap();
+        apply_draft(&mut item, &draft).unwrap();
+        if let ItemContent::Login(login) = item.content {
+            assert_eq!(
+                login.autofill_urls[0].mode,
+                pass::domain::AutofillUrlMode::Never
+            );
+            assert_eq!(login.urls, ["https://new.example.com"]);
+        }
+    }
+    fn synthetic_item(id: &str, created: &str, state: ItemState) -> Item {
+        Item {
+            id: ItemId::new(id.to_string()),
+            share_id: ShareId::new("synthetic-share".into()),
+            vault_id: pass::domain::VaultId::new("synthetic-vault".into()),
+            content: content(),
+            state,
+            flags: vec![],
+            create_time: created.parse().unwrap(),
+            modify_time: created.parse().unwrap(),
+            folder_id: None,
+            alias_email: None,
+        }
+    }
+    #[test]
+    fn native_totp_limits_exclude_trash_and_rank_existing_setup() {
+        let early = synthetic_item("early", "2026-01-01T00:00:00", ItemState::Active);
+        let later = synthetic_item("later", "2026-02-01T00:00:00", ItemState::Active);
+        let trash = synthetic_item("trashed", "2025-01-01T00:00:00", ItemState::Trashed);
+        let items = [later.clone(), trash, early.clone()];
+        assert!(!totp_allowed(Some(0), &items, None));
+        assert!(!totp_allowed(Some(1), &items, None));
+        assert!(totp_allowed(Some(1), &items, Some(&early)));
+        assert!(!totp_allowed(Some(1), &items, Some(&later)));
+        assert!(totp_allowed(Some(3), &items, None));
+        assert!(totp_allowed(None, &items, None));
+    }
+    #[test]
+    fn native_snapshot_summary_excludes_all_secret_content() {
+        let item = synthetic_item("synthetic", "2026-01-01T00:00:00", ItemState::Active);
+        let value =
+            serde_json::to_value(crate::commands::item::list::ItemSummary::from(&item)).unwrap();
+        let json = value.to_string();
+        assert!(value.get("has_totp").unwrap().as_bool().unwrap());
+        for secret in [
+            "SYNTHETIC",
+            "alex@example.com",
+            "OLD-SYNTHETIC",
+            "otpauth:",
+            "extra_fields",
+            "password",
+            "note",
+        ] {
+            assert!(!json.contains(secret));
+        }
+    }
+    #[test]
+    fn native_edit_cannot_target_a_newly_appended_field() {
+        let draft: Draft = serde_json::from_str(r#"{"kind":"login","title":"Test","note":"","custom_fields":[{"name":"New","value":"Synthetic","concealed":false},{"source_index":2,"expected_name":"New","expected_hidden":false,"name":"Changed","value":"Synthetic","concealed":false}]}"#).unwrap();
+        assert!(apply_draft(&mut content(), &draft).is_err());
+    }
+    #[test]
+    fn native_custom_deletion_keeps_other_original_indices_and_new_fields() {
+        let mut item = content();
+        let draft: Draft = serde_json::from_str(r#"{"kind":"login","title":"Test","note":"","custom_fields":[{"source_index":1,"expected_name":"Recovery","expected_hidden":true,"name":"Recovery","value":"","concealed":true,"remove":true},{"name":"Added","value":"Synthetic","concealed":false}]}"#).unwrap();
+        apply_draft(&mut item, &draft).unwrap();
+        assert_eq!(item.extra_fields.len(), 2);
+        assert_eq!(
+            item.extra_fields[0].content,
+            ItemExtraFieldContent::Timestamp(123)
+        );
+        assert_eq!(item.extra_fields[1].name, "Added");
+    }
+}
