         Ok(input.replace("\n", "").trim().to_string())
@@ -167,3 +174,48 @@ pub fn format_timestamp_with_time(timestamp: Timestamp) -> String {
         zoned.second()
     )
 }
+
+// Kept separate so the native protocol is tested without account/network/Keychain access.
+pub(crate) fn read_native_reply(reader: &mut impl std::io::BufRead) -> anyhow::Result<String> {
+    let mut line = zeroize::Zeroizing::new(String::new());
+    if std::io::BufRead::read_line(&mut std::io::Read::take(reader, 65_537), &mut line)? == 0 {
+        anyhow::bail!("Native authentication cancelled");
+    }
+    if line.len() > 65_536 { anyhow::bail!("Native credential exceeds size limit"); }
+    Ok(serde_json::from_str(&line)?)
+}
+
+#[cfg(test)]
+mod protonx_tests {
+    use super::read_native_reply;
+    use std::io::Cursor;
+    #[test]
+    fn reply_preserves_whitespace_and_newlines() {
+        let value = "  synthetic \n \" secret  ";
+        let json = serde_json::to_string(value).unwrap() + "\n";
+        assert_eq!(read_native_reply(&mut Cursor::new(json)).unwrap(), value);
+    }
+    #[test]
+    fn eof_cancels_instead_of_returning_an_empty_password() {
+        assert!(read_native_reply(&mut Cursor::new("")).is_err());
+    }
+    #[test]
+    fn non_string_reply_is_rejected() {
+        assert!(read_native_reply(&mut Cursor::new("{\"password\":\"synthetic\"}\n")).is_err());
+    }
+    #[test]
+    fn oversized_reply_is_rejected() {
+        let value = serde_json::to_string(&"x".repeat(65_537)).unwrap() + "\n";
+        assert!(read_native_reply(&mut Cursor::new(value)).is_err());
+    }
+}
+
+// Native IPC carries only a fixed failure category and numeric protocol codes.
+// Never pass raw error strings or credential data to this function.
+pub fn report_native_error(failure: &'static str, http_status: Option<u16>, api_code: Option<i64>) {
+    if std::env::var("PROTONX_NATIVE").as_deref() == Ok("1") {
+        let record = serde_json::json!({"failure": failure, "httpStatus": http_status, "apiCode": api_code});
+        eprintln!("PROTONX_ERROR:{record}");
+        let _ = std::io::stderr().flush();
+    }
+}
