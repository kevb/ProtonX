+// Copyright (c) 2026 ProtonX contributors. GPL-3.0-or-later.
+// Persistent representation retains Proton's encrypted item content. Item keys
+// and metadata must only be stored inside the existing SQLCipher database.
+use crate::domain::{
+    FolderId, Item, ItemData, ItemFlag, ItemId, ItemState, ShareId, VaultId, crypto,
+};
+use crate::{PassClient, PassClientContext};
+use anyhow::{Context, Result, ensure};
+use serde::{Deserialize, Serialize};
+use std::collections::HashMap;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeOfflineItem {
+    pub id: ItemId,
+    pub share_id: ShareId,
+    pub vault_id: VaultId,
+    pub revision: u64,
+    pub key_rotation: u8,
+    pub encrypted_content: String,
+    pub item_key: Vec<u8>,
+    pub state: ItemState,
+    pub flags: Vec<ItemFlag>,
+    pub create_time: jiff::civil::DateTime,
+    pub modify_time: jiff::civil::DateTime,
+    pub folder_id: Option<FolderId>,
+    pub alias_email: Option<String>,
+}
+
+impl Drop for NativeOfflineItem {
+    fn drop(&mut self) {
+        use zeroize::Zeroize;
+        self.item_key.zeroize();
+    }
+}
+
+impl NativeOfflineItem {
+    /// Opens exactly one record without network access, using Proton's crypto
+    /// and protobuf parser. No attachment files/metadata are downloaded offline.
+    pub fn open(&self) -> Result<Item> {
+        ensure!(
+            self.item_key.len() == crypto::KEY_LENGTH,
+            "Invalid saved item key"
+        );
+        let encrypted = crate::utils::b64_decode(&self.encrypted_content)?;
+        let data = zeroize::Zeroizing::new(
+            crypto::decrypt(
+                &encrypted,
+                &self.item_key,
+                crypto::EncryptionTag::ItemContent,
+            )
+            .map_err(|_| anyhow::anyhow!("Could not decrypt saved item"))?,
+        );
+        let content = ItemData::deserialize(&data).context("Unsupported saved item")?;
+        Ok(Item {
+            id: self.id.clone(),
+            share_id: self.share_id.clone(),
+            vault_id: self.vault_id.clone(),
+            content,
+            state: self.state,
+            flags: self.flags.clone(),
+            create_time: self.create_time,
+            modify_time: self.modify_time,
+            folder_id: self.folder_id.clone(),
+            alias_email: self.alias_email.clone(),
+        })
+    }
+}
+
+impl<C: PassClientContext> PassClient<C> {
+    /// Single network fetch/decrypt pass shared by native metadata and cache.
+    pub async fn native_snapshot_items(
+        &self,
+        share_id: &ShareId,
+    ) -> Result<Vec<(Item, NativeOfflineItem)>> {
+        let revisions = self.fetch_items(share_id).await?;
+        if revisions.is_empty() {
+            return Ok(vec![]);
+        }
+        let count = revisions.len();
+        let mut originals: HashMap<_, _> = revisions
+            .iter()
+            .map(|r| (r.item_id.clone(), r.clone()))
+            .collect();
+        ensure!(originals.len() == count, "Duplicate server item IDs");
+        let opened = self.open_items(share_id, revisions).await?;
+        ensure!(opened.len() == count, "Incomplete decrypted snapshot");
+        let mut result = Vec::with_capacity(count);
+        for entry in opened {
+            let item = entry.item;
+            let original = originals
+                .remove(item.id.value())
+                .context("Inconsistent item snapshot")?;
+            ensure!(
+                entry.item_key.key_rotation == original.key_rotation,
+                "Inconsistent key rotation"
+            );
+            let saved = NativeOfflineItem {
+                id: item.id.clone(),
+                share_id: item.share_id.clone(),
+                vault_id: item.vault_id.clone(),
+                revision: original.revision,
+                key_rotation: original.key_rotation,
+                encrypted_content: original.content,
+                item_key: entry.item_key.key.as_ref().to_vec(),
+                state: item.state,
+                flags: item.flags.clone(),
+                create_time: item.create_time,
+                modify_time: item.modify_time,
+                folder_id: item.folder_id.clone(),
+                alias_email: item.alias_email.clone(),
+            };
+            result.push((item, saved));
+        }
+        Ok(result)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::PlanType;
+    use crate::test_tools::*;
+
+    #[muon_test::test]
+    async fn native_snapshot_retains_original_ciphertext_and_rotation_for_local_selected_read(
+        server: muon_test::Server,
+    ) {
+        let (raw, api) = server.client::<()>();
+        let client = make_test_pass_client_with_setup(raw, &api, PlanType::Plus).await;
+        setup_vault_share(&api, "share");
+        setup_share_keys(&api, "share");
+        let content = create_random_item();
+        let encrypted = encrypt_item_contents(content.clone());
+        let cipher = crate::utils::b64_encode(&encrypted.encrypted_contents);
+        let revision = ItemRevisionBuilder::new("item".into())
+            .with_content(cipher.clone())
+            .with_item_key(Some(crate::utils::b64_encode(
+                &encrypted.encrypted_item_key,
+            )))
+            .with_state(ItemState::Active as u8)
+            .build();
+        let expected_revision = revision.revision;
+        let handled = api.handler_with_method(Method::GET, "/pass/v1/share/share/item", move |_| {
+            success(serde_json::json!({"Items": {"RevisionsData": [revision.clone()], "LastToken": null}}))
+        });
+        let records = client
+            .native_snapshot_items(&share_id!("share"))
+            .await
+            .unwrap();
+        assert_hit!(handled);
+        assert_eq!(records.len(), 1);
+        let (opened, saved) = &records[0];
+        assert_eq!(opened.content, content);
+        assert_eq!(saved.encrypted_content, cipher);
+        assert_eq!(saved.revision, expected_revision);
+        let local = saved.open().unwrap();
+        assert_eq!(local.content, content);
+        assert_eq!(local.id, opened.id);
+        assert_eq!(local.vault_id, opened.vault_id);
+    }
+
+    #[muon_test::test]
+    async fn native_snapshot_refuses_corrupt_revisions_instead_of_publishing_partial_cache(
+        server: muon_test::Server,
+    ) {
+        let (raw, api) = server.client::<()>();
+        let client = make_test_pass_client_with_setup(raw, &api, PlanType::Plus).await;
+        setup_vault_share(&api, "share");
+        setup_share_keys(&api, "share");
+        let encrypted = encrypt_item_contents(create_random_item());
+        let good = ItemRevisionBuilder::new("good".into())
+            .with_content(crate::utils::b64_encode(&encrypted.encrypted_contents))
+            .with_item_key(Some(crate::utils::b64_encode(
+                &encrypted.encrypted_item_key,
+            )))
+            .with_state(ItemState::Active as u8)
+            .build();
+        let mut broken = good.clone();
+        broken.item_id = "broken".into();
+        broken.content = "invalid".into();
+        api.handler_with_method(Method::GET, "/pass/v1/share/share/item", move |_| {
+            success(serde_json::json!({"Items": {"RevisionsData": [good.clone(), broken.clone()], "LastToken": null}}))
+        });
+        assert!(
+            client
+                .native_snapshot_items(&share_id!("share"))
+                .await
+                .is_err()
+        );
+    }
+}
