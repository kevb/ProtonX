+#[cfg(feature = "protonx-native")]
+impl std::fmt::Display for NativeRevisionConflict {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter.write_str("Item revision changed; reopen before editing")
+    }
