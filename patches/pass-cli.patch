+
+// Muon's public fork flow explicitly skips anonymous-session creation. The
+// desktop backend accepts the fork endpoints but rejects that preliminary
+// anonymous session. Keep the original CLI flow and eligibility policy intact.
+async fn perform_desktop_web_login<C: PassClientContext, T: Sleep>(
+    session: &Session<C>,
+    store: Arc<RwLock<PassSessionStore>>,
+    event_handler: Arc<dyn AuthEventHandler>,
+    time: &T,
+) -> Result<WebLoginResult> {
+    let env = { store.read().env.clone() };
+    let encryption_key = crate::domain::crypto::generate_encryption_key();
+    let mut flow = session.auth().from_fork().with_code().await;
+    if let WithCodeFlow::Poll(ref pending) = flow {
+        let url = build_web_login_url(&env, pending.code(), &encryption_key, "macos-pass")?;
+        event_handler.on_web_login_url_generated(&url).await?;
+    }
+    for attempt in 0..=MAX_POLL_ATTEMPTS {
+        match flow {
+            WithCodeFlow::Ok(authenticated, payload) => {
+                let credentials = authenticated.remove_auth().await
+                    .ok_or_else(|| anyhow!("Missing fork credentials"))?;
+                let payload = Zeroizing::new(payload.ok_or_else(|| anyhow!("Missing fork payload"))?);
+                let session_payload = decrypt_payload(&encryption_key,
+                    &base64::engine::general_purpose::STANDARD.encode(&*payload))?;
+                return Ok(WebLoginResult { credentials, session_payload });
+            }
+            WithCodeFlow::Failed { reason, .. } => {
+                let error: muon::Error = reason.into();
+                return Err(error.into());
+            }
+            WithCodeFlow::Poll(pending) => {
+                if attempt == MAX_POLL_ATTEMPTS { break; }
+                event_handler.on_poll_progress(attempt + 1, MAX_POLL_ATTEMPTS).await?;
+                flow = pending.poll().await;
+                if matches!(flow, WithCodeFlow::Poll(_)) {
+                    time.sleep(core::time::Duration::from_secs(POLL_INTERVAL_SECONDS)).await;
+                }
+            }
+        }
+    }
+    Err(anyhow!("Desktop authentication timed out"))
+}
+
+#[cfg(test)]
+mod protonx_tests {
+    use super::*;
+    #[test]
+    fn desktop_fork_targets_desktop_product_and_keeps_key_in_fragment() {
+        let env = Environment::from(muon::env::Prod::default());
+        let key = [42u8; 32];
+        for child in ["cli-pass", "macos-pass"] {
+            let url = build_web_login_url(&env, "SYNTHETIC-CODE", &key, child).unwrap();
+            let (public_url, fragment) = url.split_once('#').unwrap();
+            assert_eq!(public_url, "https://account.proton.me/desktop/login?app=pass");
+            let payload = urlencoding::decode(fragment.strip_prefix("payload=").unwrap()).unwrap();
+            assert_eq!(payload, format!("0:SYNTHETIC-CODE:{}:{child}", base64::engine::general_purpose::STANDARD.encode(key)));
+        }
+    }
+
+    #[test]
+    fn desktop_fork_payload_roundtrip_and_tamper_rejection() {
+        let key = [42u8; 32];
+        let nonce_bytes = [24u8; 16];
+        type Cipher = AesGcm<Aes256, U16>;
+        let cipher = Cipher::new(&Key::<Cipher>::try_from(key.as_slice()).unwrap());
+        let encrypted = cipher.encrypt(&Nonce::<U16>::try_from(nonce_bytes.as_slice()).unwrap(),
+            br#"{"keyPassword":"synthetic-passphrase"}"#.as_slice()).unwrap();
+        let mut payload = nonce_bytes.to_vec();
+        payload.extend(encrypted);
+        let encoded = base64::engine::general_purpose::STANDARD.encode(&payload);
+        assert_eq!(decrypt_payload(&key, &encoded).unwrap().key_password, "synthetic-passphrase");
+        *payload.last_mut().unwrap() ^= 1;
+        assert!(decrypt_payload(&key, &base64::engine::general_purpose::STANDARD.encode(payload)).is_err());
+        assert!(decrypt_payload(&key, "c2hvcnQ=").is_err());
+    }
+}
