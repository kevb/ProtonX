+// A desktop protocol identity does not expose the CLI product's automation,
+// agents, export, PAT, permanent deletion or process-injection surface.
+impl Commands {
+    fn is_native_desktop_supported(&self) -> bool {
+        use commands::item::{ItemCommands, create::CreateCommands};
+        match self {
+            Self::Login { username: None, pat: None, .. } | Self::Logout { .. } => true,
+            Self::Vault { command: commands::vault::VaultCommands::List { .. } } => true,
+            Self::Item { command } => match command {
+                ItemCommands::List { show_secrets: false, .. }
+                | ItemCommands::View { .. } | ItemCommands::Trash { .. }
+                | ItemCommands::Untrash { .. } => true,
+                ItemCommands::Create { create_command: CreateCommands::Login { .. } | CreateCommands::Note { .. } } => true,
+                ItemCommands::Update { fields, .. } => fields == &["@stdin"],
+                _ => false,
+            },
+            #[cfg(feature = "protonx-desktop")]
+            Self::NativeCapabilities => true,
+            _ => false,
+        }
+    }
+}
+
+#[cfg(test)]
+mod native_command_tests {
+    use super::*;
+    #[test]
+    fn desktop_rejects_cli_automation_and_bulk_secret_output() {
+        for args in [
+            vec!["pass-cli", "run", "--", "env"],
+            vec!["pass-cli", "item", "list", "--output", "json", "--show-secrets"],
+            vec!["pass-cli", "item", "delete", "--share-id", "synthetic", "--item-id", "synthetic"],
+            vec!["pass-cli", "login", "--pat", "synthetic"],
+            vec!["pass-cli", "item", "update", "--field", "password=synthetic"],
+        ] {
+            assert!(!Cli::try_parse_from(args).unwrap().command.is_native_desktop_supported());
+        }
+    }
+    #[test]
+    fn desktop_accepts_native_ui_contracts() {
+        for args in [
+            vec!["pass-cli", "login"], vec!["pass-cli", "login", "--interactive"],
+            vec!["pass-cli", "vault", "list", "--output", "json"],
+            vec!["pass-cli", "item", "list", "--share-id", "synthetic", "--output", "json"],
+            vec!["pass-cli", "item", "update", "--share-id", "synthetic", "--item-id", "synthetic", "--field", "@stdin"],
+        ] {
+            assert!(Cli::try_parse_from(args).unwrap().command.is_native_desktop_supported());
+        }
+    }
+}
diff --git a/pass-cli/src/protonx.rs b/pass-cli/src/protonx.rs
new file mode 100644
index 0000000..fedd861
--- /dev/null
+++ b/pass-cli/src/protonx.rs
@@ -0,0 +1,55 @@
+// Copyright (c) 2026 ProtonX contributors. GPL-3.0-or-later.
+// The desktop protocol header is pinned to the reviewed WebClients revision.
+// It is an API compatibility identifier; the User-Agent identifies ProtonX.
+
+#[derive(Debug, PartialEq, Eq)]
+pub struct ProductPolicy {
+    pub api_header: &'static str,
+    pub product_name: &'static str,
+    pub product_version: &'static str,
+    pub requires_cli_eligibility: bool,
+}
+
+pub fn policy() -> ProductPolicy {
+    select_policy(cfg!(feature = "protonx-desktop"), std::env::var("PROTONX_NATIVE").as_deref() == Ok("1"))
+}
+
+fn select_policy(desktop_build: bool, native_transport: bool) -> ProductPolicy {
+    if desktop_build && native_transport {
+        ProductPolicy {
+            api_header: "macos-pass@1.42.0",
+            product_name: "ProtonX",
+            product_version: "0.1.0",
+            requires_cli_eligibility: false,
+        }
+    } else {
+        ProductPolicy {
+            api_header: concat!("cli-pass@", env!("CARGO_PKG_VERSION")),
+            product_name: "Pass",
+            product_version: env!("CARGO_PKG_VERSION"),
+            requires_cli_eligibility: true,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cli_identity_always_retains_cli_eligibility() {
+        for (desktop_build, native_transport) in [(false, false), (false, true), (true, false)] {
+            let policy = select_policy(desktop_build, native_transport);
+            assert!(policy.api_header.starts_with("cli-pass@"));
+            assert!(policy.requires_cli_eligibility);
+        }
+    }
+
+    #[test]
+    fn explicit_native_desktop_build_uses_desktop_policy() {
+        let policy = select_policy(true, true);
+        assert_eq!(policy.api_header, "macos-pass@1.42.0");
+        assert_eq!(policy.product_name, "ProtonX");
+        assert!(!policy.requires_cli_eligibility);
+    }
+}
