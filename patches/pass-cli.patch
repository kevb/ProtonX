+// Copyright (c) 2026 ProtonX contributors. GPL-3.0-or-later.
+// The desktop protocol header is pinned to the reviewed WebClients revision.
+// It is an API compatibility identifier; the User-Agent identifies ProtonX.
+
+#[derive(Debug, PartialEq, Eq)]
+pub struct ProductPolicy {
+    pub api_header: &'static str,
+    pub product_name: &'static str,
+    pub product_version: &'static str,
+    pub requires_cli_eligibility: bool,
+}
+
+pub fn policy() -> ProductPolicy {
+    select_policy(cfg!(feature = "protonx-desktop"), std::env::var("PROTONX_NATIVE").as_deref() == Ok("1"))
+}
+
+fn select_policy(desktop_build: bool, native_transport: bool) -> ProductPolicy {
+    if desktop_build && native_transport {
+        ProductPolicy {
+            api_header: "macos-pass@1.42.0",
+            product_name: "ProtonX",
+            product_version: "0.1.0",
+            requires_cli_eligibility: false,
+        }
+    } else {
+        ProductPolicy {
+            api_header: concat!("cli-pass@", env!("CARGO_PKG_VERSION")),
+            product_name: "Pass",
+            product_version: env!("CARGO_PKG_VERSION"),
+            requires_cli_eligibility: true,
+        }
+    }
+}
