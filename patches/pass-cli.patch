+// Copyright (c) 2026 ProtonX contributors. GPL-3.0-or-later.
+// Local-only, read-only cache API. This module has no network client or write queue.
+use anyhow::{Context, Result, ensure};
+use pass::{NativeOfflineItem, PlanType};
+use pass_db::{
+    DatabaseManager,
+    rusqlite::{OptionalExtension, params},
+};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+pub fn session_binding(
+    store: &std::sync::Arc<parking_lot::RwLock<pass::auth::PassSessionStore>>,
+) -> Result<(String, String)> {
+    use sha2::{Digest, Sha256};
+    let store = store.read();
+    ensure!(!store.needs_extra_password(), CacheUnavailable);
+    let auth = store.auth.lock();
+    let auth = auth.as_ref().ok_or(CacheUnavailable)?;
+    let user = auth.user_id().ok_or(CacheUnavailable)?.to_owned();
+    let uid = auth.uid().ok_or(CacheUnavailable)?;
+    ensure!(auth.has_scope("pass"), CacheUnavailable);
+    Ok((user, hex::encode(Sha256::digest(uid.as_bytes()))))
+}
+
+pub const CACHE_TTL: i64 = 24 * 60 * 60;
+const MAX_HEADER_BYTES: usize = 8 * 1024 * 1024;
+const MAX_ITEM_BYTES: usize = 2 * 1024 * 1024;
+const MAX_CACHE_BYTES: usize = 128 * 1024 * 1024;
+const MAX_ITEMS: usize = 20_000;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Header {
+    pub schema: u32,
+    pub user_id: String,
+    pub session_id: String,
+    pub plan: PlanType,
+    pub saved_at: i64,
+    pub expires_at: i64,
+    pub generation: String,
+    pub snapshot: Value,
+}
+
+/// Unknown/managed policies are denied. End/trial dates further bound our lease.
+/// A local lease cannot discover server revocation until reconnecting.
+pub fn expiry(plan: &pass::PassPlan, now: i64) -> Option<i64> {
+    if plan.plan_type != PlanType::Plus {
+        return None;
+    }
+    let mut end = now.checked_add(CACHE_TTL)?;
+    for bound in [plan.subscription_end, plan.trial_end]
+        .into_iter()
+        .flatten()
+    {
+        if bound > 0 {
+            end = end.min(i64::try_from(bound).ok()?);
+        }
+    }
+    (end > now).then_some(end)
+}
+
+impl Header {
+    fn valid(&self, user: &str, session: &str, now: i64) -> bool {
+        self.schema == 1
+            && self.user_id == user
+            && self.session_id == session
+            && self.plan == PlanType::Plus
+            && uuid::Uuid::parse_str(&self.generation).is_ok()
+            && self.saved_at > 0
+            && now >= self.saved_at
+            && now < self.expires_at
+            && self.expires_at > self.saved_at
+            && self.expires_at - self.saved_at <= CACHE_TTL
+    }
+}
+
+#[derive(Debug)]
+pub struct CacheUnavailable;
+impl std::fmt::Display for CacheUnavailable {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("Saved vault is unavailable; refresh online")
+    }
+}
+impl std::error::Error for CacheUnavailable {}
+
+async fn connection(db: &DatabaseManager) -> Result<pass_db::DbConnection> {
+    let conn = db.get_connection().await?;
+    conn.interact_blocking(|conn| {
+        conn.busy_timeout(std::time::Duration::from_secs(5))?;
+        conn.execute_batch(
+            "CREATE TABLE IF NOT EXISTS protonx_cache_header (
+            singleton INTEGER PRIMARY KEY CHECK(singleton = 1), payload BLOB NOT NULL);
+            CREATE TABLE IF NOT EXISTS protonx_cache_items (
+            share_id TEXT NOT NULL, item_id TEXT NOT NULL, payload BLOB NOT NULL,
+            PRIMARY KEY (share_id, item_id));",
+        )
+    })?;
+    Ok(conn)
+}
+
+pub async fn clear(db: &DatabaseManager) -> Result<()> {
+    let conn = connection(db).await?;
+    conn.interact_blocking(|conn| -> Result<()> {
+        let tx = conn.unchecked_transaction()?;
+        tx.execute("DELETE FROM protonx_cache_header", [])?;
+        tx.execute("DELETE FROM protonx_cache_items", [])?;
+        tx.commit()?;
+        Ok(())
+    })
+}
+
+/// One atomic generation, so interrupted refresh cannot publish a partial vault.
+pub async fn replace(
+    db: &DatabaseManager,
+    header: Header,
+    records: Vec<NativeOfflineItem>,
+) -> Result<()> {
+    ensure!(
+        header.valid(&header.user_id, &header.session_id, header.saved_at),
+        "Invalid cache lease"
+    );
+    ensure!(records.len() <= MAX_ITEMS, "Saved vault is too large");
+    let header = serde_json::to_vec(&header)?;
+    ensure!(
+        header.len() <= MAX_HEADER_BYTES,
+        "Saved metadata is too large"
+    );
+    let mut size = header.len();
+    let mut rows = Vec::with_capacity(records.len());
+    for record in records {
+        let data = zeroize::Zeroizing::new(serde_json::to_vec(&record)?);
+        ensure!(data.len() <= MAX_ITEM_BYTES, "Saved item is too large");
+        size += data.len();
+        ensure!(size <= MAX_CACHE_BYTES, "Saved vault is too large");
+        rows.push((record.share_id.to_string(), record.id.to_string(), data));
+    }
+    let conn = connection(db).await?;
+    conn.interact_blocking(move |conn| -> Result<()> {
+        let tx = conn.unchecked_transaction()?;
+        tx.execute("DELETE FROM protonx_cache_items", [])?;
+        tx.execute("DELETE FROM protonx_cache_header", [])?;
+        tx.execute(
+            "INSERT INTO protonx_cache_header VALUES (1, ?1)",
+            params![header],
+        )?;
+        for (share, item, data) in rows {
+            tx.execute(
+                "INSERT INTO protonx_cache_items VALUES (?1, ?2, ?3)",
+                params![share, item, data.as_slice()],
+            )?;
+        }
+        tx.commit()?;
+        Ok(())
+    })
+}
+
+fn read_header(
+    conn: &pass_db::rusqlite::Connection,
+    user: &str,
+    session: &str,
+    now: i64,
+) -> Result<Option<Header>> {
+    let raw: Option<Vec<u8>> = conn
+        .query_row(
+            "SELECT payload FROM protonx_cache_header WHERE singleton=1 AND length(payload)<=?1",
+            params![MAX_HEADER_BYTES as i64],
+            |row| row.get(0),
+        )
+        .optional()?;
+    let Some(raw) = raw else {
+        return Ok(None);
+    };
+    let header: Header = serde_json::from_slice(&raw).context("Invalid saved metadata")?;
+    Ok(header.valid(user, session, now).then_some(header))
+}
+
+pub async fn snapshot(
+    db: &DatabaseManager,
+    user: String,
+    session: String,
+    now: i64,
+) -> Result<Option<Value>> {
+    let conn = connection(db).await?;
+    conn.interact_blocking(move |conn| -> Result<Option<Value>> {
+        Ok(read_header(conn, &user, &session, now)?.map(|header| {
+            serde_json::json!({
+                "snapshot": header.snapshot, "saved_at": header.saved_at,
+                "expires_at": header.expires_at, "generation": header.generation
+            })
+        }))
+    })
+}
+
+/// Check header, generation and selected row within one SQL read transaction.
+/// The entire vault's item content is never deserialized into the UI.
+pub async fn detail(
+    db: &DatabaseManager,
+    user: String,
+    session: String,
+    now: i64,
+    generation: String,
+    share: String,
+    item: String,
+) -> Result<Value> {
+    let conn = connection(db).await?;
+    conn.interact_blocking(move |conn| -> Result<Value> {
+        let tx = conn.unchecked_transaction()?;
+        let header = read_header(&tx, &user, &session, now)?.ok_or(CacheUnavailable)?;
+        ensure!(header.generation == generation, CacheUnavailable);
+        let raw: Vec<u8> = tx.query_row("SELECT payload FROM protonx_cache_items WHERE share_id=?1 AND item_id=?2 AND length(payload)<=?3",
+            params![share, item, MAX_ITEM_BYTES as i64], |row| row.get(0)).optional()?.ok_or(CacheUnavailable)?;
+        let record: NativeOfflineItem = serde_json::from_slice(&raw).context("Invalid saved item")?;
+        ensure!(record.share_id.value() == share && record.id.value() == item, CacheUnavailable);
+        let opened = record.open()?;
+        let files_unavailable = opened.flags.contains(&pass::domain::ItemFlag::ItemHasFiles);
+        Ok(serde_json::json!({"item": opened, "attachments": [], "revision": record.revision,
+            "offline_attachments_unavailable": files_unavailable}))
+    })
+}
