+#[cfg(all(test, feature = "protonx-native"))]
+mod native_revision_tests {
+    use super::*;
+    use crate::PlanType;
+    use crate::domain::{ItemContent, ItemState, LoginItem};
+    use crate::test_tools::*;
+
+    #[muon_test::test]
+    async fn native_view_then_password_edit_accepts_active_wire_state(server: muon_test::Server) {
+        let (raw_client, api) = server.client::<()>();
+        let client = make_test_pass_client_with_setup(raw_client, &api, PlanType::Plus).await;
+        const SHARE: &str = "synthetic-share";
+        const ITEM: &str = "synthetic-login";
+        setup_vault_share(&api, SHARE);
+        setup_share_keys(&api, SHARE);
+        let original = ItemData::new(
+            "Synthetic login".into(),
+            "Synthetic preserved note".into(),
+            "synthetic-uuid".into(),
+            ItemContent::Login(LoginItem {
+                email: "demo@example.com".into(),
+                username: "synthetic-user".into(),
+                password: "Dummy-Test-Only-73".into(),
+                urls: vec!["https://example.com".into()],
+                totp_uri: String::new(),
+                passkeys: vec![],
+                autofill_urls: vec![],
+            }),
+            vec![],
+        )
+        .unwrap();
+        let encrypted = encrypt_item_contents(original.clone());
+        let revision = ItemRevisionBuilder::new(ITEM.into())
+            .with_revision(7)
+            .with_state(ItemState::Active as u8)
+            .with_content(crate::utils::b64_encode(&encrypted.encrypted_contents))
+            .with_item_key(Some(crate::utils::b64_encode(
+                &encrypted.encrypted_item_key,
+            )))
+            .build();
+        setup_item_revision(&api, SHARE, ITEM, revision.clone());
+        let update = api.handler_with_method(
+            Method::PUT,
+            "/pass/v1/share/synthetic-share/item/synthetic-login",
+            |_| success_code(),
+        );
+        // Viewing does not change either the encrypted content or its revision.
+        let details = client
+            .view_item(&ShareId::new(SHARE.into()), &ItemId::new(ITEM.into()))
+            .await
+            .unwrap();
+        assert_eq!(details.revision, 7);
+        let mut changed = details.item.content;
+        if let ItemContent::Login(login) = &mut changed.content {
+            login.password = "Dummy-Test-Only-73!".into();
+        }
+        // Public mock handlers are consumed once; install the next unchanged server read.
+        setup_item_revision(&api, SHARE, ITEM, revision);
+        let recorder = api.new_recorder();
+        client
+            .update_native_item(
+                &ShareId::new(SHARE.into()),
+                &ItemId::new(ITEM.into()),
+                changed.clone(),
+                details.revision,
+            )
+            .await
+            .unwrap();
+        assert_hit!(update);
+        let request: UpdateItemRequest = last_request!(recorder);
+        assert_eq!(request.last_revision, 7);
+        let ciphertext = crate::utils::b64_decode(&request.content).unwrap();
+        let plaintext = crypto::decrypt(
+            &ciphertext,
+            encrypted.item_key.as_ref(),
+            crypto::EncryptionTag::ItemContent,
+        )
+        .unwrap();
+        let decoded = ItemData::deserialize(&plaintext).unwrap();
+        assert_eq!(decoded, changed);
+        assert_eq!(decoded.note, original.note);
+        assert_eq!(decoded.item_uuid, original.item_uuid);
+    }
