+
+// ProtonX: bytes stay in the helper until an explicit native export/preview.
+#[cfg(feature = "protonx-native")]
+impl DecryptedAttachment {
+    pub async fn native_content(&self) -> std::io::Result<Vec<u8>> {
+        const MAX: usize = 25_000_000;
+        if self.attachment_metadata.size > MAX as u64 {
+            return Err(std::io::ErrorKind::InvalidData.into());
+        }
+        // Encrypted containers have bounded overhead; never read an unbounded file.
+        if tokio::fs::metadata(&self.data_path).await?.len() > (MAX + 1_000_000) as u64 {
+            return Err(std::io::ErrorKind::InvalidData.into());
+        }
+        let bytes = crate::cache_storage::read(&self.data_path).await?;
+        if bytes.len() > MAX { return Err(std::io::ErrorKind::InvalidData.into()); }
+        Ok(bytes)
+    }
+}
