+#[cfg(feature = "protonx-native")]
+impl Mailbox {
+    /// Native-only bounded export. Cache paths are never exposed over app IPC.
+    pub async fn protonx_attachment_content(&self, id: Id) -> Result<Vec<u8>, ActionError> {
+        let ctx = self.ctx()?;
+        uniffi_async(async move {
+            let mut tether = ctx.user_stash().connection();
+            let attachment = Attachment::get_attachment(&ctx, id.into(), &mut tether).await?;
+            attachment.native_content().await.map_err(|e| RealProtonMailError::from(anyhow::anyhow!(e)))
+        }).await.map_err(ActionError::from)
+    }
+}
