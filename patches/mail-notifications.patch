 impl MailUserSession {
+    /// Local, read-only CREATE-event projection for the ProtonX native adapter.
+    /// Not exported through UniFFI and inactive until explicitly armed.
+    #[cfg(feature = "protonx-native")]
+    pub async fn protonx_notifications(&self, operation: u8) -> Result<Vec<mail_common::native_notifications::NativeNotification>, ProtonError> {
+        let ctx = self.ctx()?;
+        let queue = ctx.get_service::<mail_common::native_notifications::NativeNotifications>();
+        match operation {
+            0 => { queue.stop(); Ok(Vec::new()) },
+            1 => { queue.start(); Ok(Vec::new()) },
+            2 => queue.drain(&ctx).await.map_err(|_| UnexpectedError::Internal.into()),
+            _ => Err(UnexpectedError::Internal.into()),
+        }
+    }
+
     pub(crate) fn new(ctx: MailUserContextPtr) -> Arc<Self> {
         Arc::new(Self { ctx })
     }
